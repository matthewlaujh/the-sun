	(text "DESIGN A — disc, 172 x SK6812 RGBW, used on 1 board(s)"
		(at 38.1 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left)
		)
		(uuid "79d0cf4d-8bae-5e16-8236-f76083d978a2")
	)
	(text "- Data chain: J1.DATA_IN -> R1 (100R) -> LED1.DIN; LEDk.DOUT -> LEDk+1.DIN; LED172.DOUT -> J2.DATA_OUT."
		(at 38.1 21.59 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "156e7d1b-5c43-5757-a645-2bac3805d5f4")
	)
	(text "- Reference designators LED1..LED172 / C1..C172 are the chain order from designs/design-A-placement.csv — do not re-annotate."
		(at 38.1 26.67 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "93f72271-00ce-5687-a5b6-5606b9382f94")
	)
	(text "- Universe spans on the representative board: U1 ch1-512 (128 px), U2 ch1-176 (44 px). Universes run on across the daisy chain — see dmx-patch.csv."
		(at 38.1 31.75 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "7db12b2b-f7c6-57a0-bcb4-16d8d8fa0d6b")
	)
	(text "- Full white: 13.76 A @ 5 V. J1 and J2 are the ONLY connectors — both land on the same +5V/GND pours, so the board can be fed from either end. Feed each board its own PSU pair at J1; do not chain 13.76 A of board current through an upstream board's pigtail."
		(at 38.1 36.83 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "f22bbb9f-8e21-51d8-a38c-51bfb3f5deca")
	)
	(text "- C1..C172 = one 0603/100nF/50V X7R per LED, <= 2 mm from its package. Passive values read <package>/<value>/<voltage>."
		(at 38.1 41.91 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "f733aca3-d6c7-59b2-9454-cf2b6a6e3964")
	)
	(text "- J1/J2 pinout: pin 1 = +5V, pin 2 = GND, pin 3 = DATA. Boards daisy-chain J2 (DOUT) -> next board J1 (DIN) per boards.csv."
		(at 38.1 46.99 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "8c5aee40-6a37-5671-8fef-3464a9360563")
	)
	(text "- No level shifter: the PixLite E4-S Mk3 drives 5 V data directly. Keep board-to-board pigtails < 150 mm and pair DATA with GND."
		(at 38.1 52.07 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "bedd28e7-32b4-5ef6-a98b-bfabe4ff8084")
	)
