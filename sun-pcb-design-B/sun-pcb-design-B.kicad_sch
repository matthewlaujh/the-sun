	(text "DESIGN B — wedge, 109 x SK6812 RGBW, used on 12 board(s)"
		(at 38.1 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left)
		)
		(uuid "8dd25ba1-7587-5055-89a2-f02f2c5615b7")
	)
	(text "- Data chain: J1.DATA_IN -> R1 (100R) -> LED1.DIN; LEDk.DOUT -> LEDk+1.DIN; LED109.DOUT -> J2.DATA_OUT."
		(at 38.1 21.59 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "59384cbf-b95f-5a98-bb87-5fa4f4ac6f0b")
	)
	(text "- Reference designators LED1..LED109 / C1..C109 are the chain order from designs/design-B-placement.csv — do not re-annotate."
		(at 38.1 26.67 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "90bec61f-09f5-5a86-b366-c4a9c7f394ac")
	)
	(text "- Universe spans on the representative board: U2 ch177-512 (84 px), U3 ch1-100 (25 px). Universes run on across the daisy chain — see dmx-patch.csv."
		(at 38.1 31.75 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "8b6da777-3895-55d3-9b24-d856508ea96a")
	)
	(text "- Full white: 8.72 A @ 5 V. J1 and J2 are the ONLY connectors — both land on the same +5V/GND pours, so the board can be fed from either end. Feed each board its own PSU pair at J1; do not chain 8.72 A of board current through an upstream board's pigtail."
		(at 38.1 36.83 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "58494600-78ee-5981-a514-d271e7ea5760")
	)
	(text "- C1..C109 = one 0603/100nF/50V X7R per LED, <= 2 mm from its package. Passive values read <package>/<value>/<voltage>."
		(at 38.1 41.91 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "6ff487e1-b44c-5891-9185-7e1d324cb49f")
	)
	(text "- J1/J2 pinout: pin 1 = +5V, pin 2 = GND, pin 3 = DATA. Boards daisy-chain J2 (DOUT) -> next board J1 (DIN) per boards.csv."
		(at 38.1 46.99 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "0e62ec66-7255-5233-bbee-8b2797b7adb3")
	)
	(text "- No level shifter: the PixLite E4-S Mk3 drives 5 V data directly. Keep board-to-board pigtails < 150 mm and pair DATA with GND."
		(at 38.1 52.07 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "b879ef2c-14d8-5e62-a896-46a4f7115370")
	)
