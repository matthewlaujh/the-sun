	(text "DESIGN C — wedge, 78 x SK6812 RGBW, used on 12 board(s)"
		(at 38.1 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left)
		)
		(uuid "6cc61128-0b71-50c2-b1d0-34d1df13cb01")
	)
	(text "- Data chain: J1.DATA_IN -> R1 (100R) -> LED1.DIN; LEDk.DOUT -> LEDk+1.DIN; LED78.DOUT -> J2.DATA_OUT."
		(at 38.1 21.59 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "eb065b4b-6f57-5b42-b9a1-5a7d00d4c6de")
	)
	(text "- Reference designators LED1..LED78 / C1..C78 are the chain order from designs/design-C-placement.csv — do not re-annotate."
		(at 38.1 26.67 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "184b53ac-a2bc-5ab2-a8d8-fcdc764262c8")
	)
	(text "- Universe spans on the representative board: U13 ch285-512 (57 px), U14 ch1-84 (21 px). Universes run on across the daisy chain — see dmx-patch.csv."
		(at 38.1 31.75 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "effcb890-335f-58a4-bcb1-67ddfa1e0947")
	)
	(text "- Full white: 6.24 A @ 5 V. J1 and J2 are the ONLY connectors — both land on the same +5V/GND pours, so the board can be fed from either end. Feed each board its own PSU pair at J1; do not chain 6.24 A of board current through an upstream board's pigtail."
		(at 38.1 36.83 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "498add66-a3b1-5a9d-b90b-167edbaef704")
	)
	(text "- C1..C78 = one 0603/100nF/50V X7R per LED, <= 2 mm from its package. Passive values read <package>/<value>/<voltage>."
		(at 38.1 41.91 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "9fd42349-df8f-539a-a9c1-e277854ec484")
	)
	(text "- J1/J2 pinout: pin 1 = +5V, pin 2 = GND, pin 3 = DATA. Boards daisy-chain J2 (DOUT) -> next board J1 (DIN) per boards.csv."
		(at 38.1 46.99 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "3c66bc3a-3e4a-5184-80f9-0d351e5b4f9e")
	)
	(text "- No level shifter: the PixLite E4-S Mk3 drives 5 V data directly. Keep board-to-board pigtails < 150 mm and pair DATA with GND."
		(at 38.1 52.07 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "896926f2-2cac-5432-a057-46fdd70bef41")
	)
