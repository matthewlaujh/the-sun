# copy to server/.env and edit — this file lives on the droplet (and on your Mac); it is never committed or sent to GitHub
SUN_ADMIN_KEY=choose-a-long-passphrase
DOMAIN=sun.example.com        # leave as :80 to serve plain http on the droplet's IP
CORS_ORIGINS=                 # optional: https://matthewlaujh.github.io  (comma-separated). Empty = allow any origin
